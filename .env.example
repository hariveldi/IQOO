# Database
DATABASE_URL="postgresql://user:password@localhost:5432/iqoo_productivity"

# Server
SERVER_PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend
VITE_API_URL=http://localhost:3001/api

# AI Provider (use openai for real LLM reasoning; local is deterministic fallback)
# Options: openai, local
AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
# Required when AI_PROVIDER=openai. Keep this value server-side only.
# OPENAI_API_KEY=sk-your-key-here

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (for reminders/notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
