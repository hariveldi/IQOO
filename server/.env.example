# AI provider configuration
# Supported values: openai, xkiro, local
AI_PROVIDER=xkiro
AI_MODEL=minimax/minimax-m3

# Keep provider keys server-side only. Never add this value to client/.env.
XKIRO_API_KEY=your-xkiro-api-key-here

# OpenAI alternative:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here