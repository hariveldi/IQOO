# Database
DATABASE_URL="file:./prisma/dev.db"

# Server
SERVER_PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=iqoo_dev_jwt_secret_change_me
JWT_REFRESH_SECRET=iqoo_dev_refresh_secret_change_me
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend
VITE_API_URL=http://localhost:3001/api

# AI provider configuration (Phone-First AI Action Engine)
# Supported values: gemini, xkiro, openai, local
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest

# Google Gemini API Key (Gemini Flash)
# Keep provider keys server-side only. Never add this value to client/.env.
GEMINI_API_KEY=your-gemini-api-key-here

# xKiro alternative:
# AI_PROVIDER=xkiro
# AI_MODEL=qwen/qwen3.8-omni-flash:free
# XKIRO_API_KEY=your-xkiro-api-key-here

# OpenAI alternative:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp

# CORS
CORS_ORIGIN=http://localhost:5173